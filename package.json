{
  "name": "personal-blog",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:code && pnpm lint:css && pnpm lint:md",
    "lint:code": "eslint .",
    "lint:css": "stylelint \"src/**/*.{css,astro}\"",
    "lint:md": "markdownlint-cli2",
    "check": "astro check",
    "test:toolchain": "node scripts/test-toolchain.mjs",
    "test:e2e:bootstrap": "playwright test",
    "verify:bootstrap": "node scripts/verify-bootstrap.mjs"
  },
  "dependencies": {
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "typescript-eslint": "8.71.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-html": "2.0.0",
    "postcss-html": "2.0.0",
    "markdownlint-cli2": "0.23.3",
    "vitest": "5.0.4",
    "@playwright/test": "1.64.1",
    "parse5": "8.0.1",
    "postcss": "8.5.30",
    "globals": "17.13.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
